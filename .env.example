TOSEC_DATABASE_URL=postgresql+psycopg://tosec:tosec@localhost:5432/tosec_index
TOSEC_CACHE_DIR=.tosec-index-cache
TOSEC_INPUT_DIRS=[]
TOSEC_INCLUDE_PATH_KEYWORDS=[]
TOSEC_PDF_DPI=200
TOSEC_PAGE_IMAGE_MAX_DIMENSION=4000
TOSEC_OCR_BACKEND=tesseract
TOSEC_OCR_LANGUAGES=eng+fra
TOSEC_OCR_MAX_IMAGE_DIMENSION=3000
TOSEC_TESSERACT_CMD=tesseract
TOSEC_PDF_TEXT_MIN_CHARS=40
TOSEC_LLM_BASE_URL=http://127.0.0.1:8080/v1
TOSEC_LLM_MODEL=local-model
TOSEC_LLM_MODEL_VERSION=unknown
TOSEC_LLM_API_KEY=not-needed
TOSEC_LLM_TIMEOUT_SECONDS=180
TOSEC_LLM_MAX_OUTPUT_TOKENS=4096
TOSEC_LLM_RESPONSE_FORMAT=json_schema
TOSEC_PROMPT_PATH=prompts/extract_mentions.txt
TOSEC_INDEX_PROMPT_PATH=prompts/extract_index_entries.txt
TOSEC_INDEX_DISCOVERY_THRESHOLD=5.0
TOSEC_INDEX_CANDIDATE_REOCR_PSM=4
TOSEC_INDEX_LLM_MAX_OUTPUT_TOKENS=3072
TOSEC_INDEX_EXTRACTION_STRATEGY=text
TOSEC_INDEX_SECTIONS=["reviews","previews"]
